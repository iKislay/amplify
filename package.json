{
  "name": "amplify",
  "displayName": "Amplify",
  "description": "Expand short prompts into detailed engineering instructions using Copilot.",
  "version": "0.1.0",
  "publisher": "whykislay",
  "repository": {
    "type": "git",
    "url": "https://github.com/iKislay/amplify.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "amplify.expandPrompt",
        "title": "Expand Prompt"
      }
    ],
    "keybindings": [
      {
        "command": "amplify.expandPrompt",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "configuration": {
      "title": "Amplify",
      "properties": {
        "amplify.systemPrompt": {
          "type": "string",
          "default": "You are an expert prompt engineer. Take the user's short shorthand instruction and expand it into a highly detailed, structured prompt for an AI coding assistant. Include sections for context, requirements, edge cases, and expected output format.",
          "description": "The system prompt used to expand the user's input."
        },
        "amplify.fallbackProvider": {
          "type": "string",
          "enum": ["none", "groq", "gemini"],
          "default": "none",
          "description": "Fallback AI provider if Copilot is not available."
        },
        "amplify.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Groq fallback."
        },
        "amplify.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Gemini fallback."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "amplify",
        "name": "amplify",
        "description": "Expand prompts and generate code directly in chat.",
        "isDefault": false
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "typescript": "^5.4.5",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0"
  }
}
